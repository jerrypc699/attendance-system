# ==============================================================================
# Anti-Cheat Attendance System - Production Environment Configuration
# Copy this file to .env and customize for your company server
# ==============================================================================
APP_NAME=Anti-Cheat Biometric Attendance System
COMPANY_NAME=My Company
ENVIRONMENT=production

# Database: SQLite (WAL mode) by default, or PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:STRONG_PASS@localhost:5432/attendance_db
DATABASE_URL=sqlite:///./attendance.db

# Cryptographic secret (auto-generated on first boot if omitted, MUST be set in production)
SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_SECRET

# Initial Admin credentials (seeded ONCE if admin_users table is empty; change password from dashboard!)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMe@2026!

# CORS allowed origins (comma-separated, e.g. https://attendance.yourcompany.com)
ALLOWED_ORIGINS=https://attendance.yourcompany.com

# Public HTTPS URL of this server (used for links and QR)
PUBLIC_BASE_URL=https://attendance.yourcompany.com

# Cloudflare Tunnel / Reverse Proxy IP trust
TRUSTED_PROXY_HEADERS=true

# Security thresholds (initial defaults; editable persistently from Dashboard)
CHALLENGE_EXPIRY_SECONDS=45
DEFAULT_GEOFENCE_RADIUS_METERS=100
MAX_GPS_ACCURACY_THRESHOLD_METERS=50.0
FACE_SIMILARITY_THRESHOLD=0.42
PASSIVE_LIVENESS_THRESHOLD=0.55
REQUIRE_WIFI_OR_BEACON=false
REQUIRE_SERVER_FACE_AI=true
PREVENT_DUPLICATE_PUNCH=true
QR_ROTATION_SECONDS=20

# Android APK distribution URL (e.g. GitHub Releases latest download URL)
ANDROID_APK_URL=/download-apk
ANDROID_LATEST_VERSION=2.0.0

